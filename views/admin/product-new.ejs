<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Add New Product - Admin Panel</title>

  <!-- Tailwind CSS & FontAwesome -->
  <link rel="stylesheet" href="/css/tailwind-output.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

  <style>
    body {
      font-family: 'Helvetica Neue', Arial, sans-serif;
      background-color: #f8fafc;
      color: #1e293b;
    }
  </style>
</head>
<body class="p-6">
  <div class="max-w-3xl mx-auto space-y-8">

    <!-- Header -->
    <div class="flex items-center justify-between border-b border-gray-200 pb-5">
      <div>
        <h1 class="text-3xl font-light tracking-wide text-gray-900 uppercase">Create New Product</h1>
        <p class="text-sm text-gray-500 mt-1">Inject new catalog items directly into Producthome or Paintello database.</p>
      </div>
      <a href="/user/admin/finance" class="px-4 py-2 text-xs font-semibold uppercase tracking-wider text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 transition">
        <i class="fa-solid fa-arrow-left mr-2"></i> Back to Finance
      </a>
    </div>

    <!-- Flash Errors -->
    <% if (flashErrors && flashErrors.length > 0) { %>
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 text-sm">
        <%= flashErrors[0] %>
      </div>
    <% } %>

    <!-- Product Form -->
    <form action="/user/admin/products/new" method="POST" class="bg-white p-8 border border-gray-200 shadow-sm space-y-6">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <!-- Target Model Selection -->
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-2">Database Model Type *</label>
        <select name="modelType" required class="w-full px-3 py-2 border border-gray-300 text-sm focus:outline-none focus:ring-1 focus:ring-black">
          <option value="Producthome">Producthome (Default Store Catalog)</option>
          <option value="Paintello">Paintello (Paintello Home Showcase)</option>
        </select>
      </div>

      <!-- Title & Subtitle -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-2">Product Title *</label>
          <input type="text" name="title" required placeholder="e.g. Ceramic Deco Vase" class="w-full px-3 py-2 border border-gray-300 text-sm focus:outline-none focus:ring-1 focus:ring-black">
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-2">Subtitle / Tagline</label>
          <input type="text" name="subtitle" placeholder="e.g. Handcrafted in Algeria" class="w-full px-3 py-2 border border-gray-300 text-sm focus:outline-none focus:ring-1 focus:ring-black">
        </div>
      </div>

      <!-- Pricing & Stock -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-2">Selling Price (DZD) *</label>
          <input type="number" step="0.01" min="0" name="price" required placeholder="2500" class="w-full px-3 py-2 border border-gray-300 text-sm focus:outline-none focus:ring-1 focus:ring-black">
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-2">Cost / Buy Price (DZD)</label>
          <input type="number" step="0.01" min="0" name="buyPrice" placeholder="1200" class="w-full px-3 py-2 border border-gray-300 text-sm focus:outline-none focus:ring-1 focus:ring-black">
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-2">Stock Quantity *</label>
          <input type="number" min="0" name="stock" value="10" required placeholder="10" class="w-full px-3 py-2 border border-gray-300 text-sm focus:outline-none focus:ring-1 focus:ring-black">
        </div>
      </div>

      <!-- Old Price & Status/Href -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-2">Old Price (DZD) (Optional)</label>
          <input type="number" step="0.01" min="0" name="oldPrice" placeholder="3200" class="w-full px-3 py-2 border border-gray-300 text-sm focus:outline-none focus:ring-1 focus:ring-black">
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-2">Status (Paintello)</label>
          <input type="text" name="status" placeholder="New, Best Seller, etc." class="w-full px-3 py-2 border border-gray-300 text-sm focus:outline-none focus:ring-1 focus:ring-black">
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-2">Custom Link (Paintello Href)</label>
          <input type="text" name="href" placeholder="/producthome/..." class="w-full px-3 py-2 border border-gray-300 text-sm focus:outline-none focus:ring-1 focus:ring-black">
        </div>
      </div>

      <!-- Category & Type -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-2">Primary Category *</label>
          <select name="category" required class="w-full px-3 py-2 border border-gray-300 text-sm focus:outline-none focus:ring-1 focus:ring-black">
            <option value="vases">Vases</option>
            <option value="lampshades">Lampshades</option>
            <option value="lighting">Lighting</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-2">Type Keyword</label>
          <input type="text" name="type" placeholder="e.g. vase, lampshade, eclairage" class="w-full px-3 py-2 border border-gray-300 text-sm focus:outline-none focus:ring-1 focus:ring-black">
        </div>
      </div>

      <!-- Image URLs & Transparent Cutout -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-2">Image URLs (One URL per line)</label>
          <textarea name="image" rows="3" placeholder="https://example.com/image1.jpg&#10;https://example.com/image2.jpg" class="w-full px-3 py-2 border border-gray-300 text-sm focus:outline-none focus:ring-1 focus:ring-black"></textarea>
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-2">Transparent PNG Cutout URL (Room Visualizer)</label>
          <input type="text" name="transparentImage" placeholder="https://example.com/vase-transparent.png" class="w-full px-3 py-2 border border-gray-300 text-sm focus:outline-none focus:ring-1 focus:ring-black">
          <p class="text-[11px] text-gray-400 mt-1">Utilisé dans la simulation 'Visualiser chez vous' pour afficher directement le vase sans fond.</p>
        </div>
      </div>

      <!-- Media & Files (Video / 3D Model) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-2">YouTube Video ID</label>
          <input type="text" name="videoId" placeholder="e.g. dQw4w9WgXcQ" class="w-full px-3 py-2 border border-gray-300 text-sm focus:outline-none focus:ring-1 focus:ring-black">
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-2">Video File URL</label>
          <input type="text" name="videoFile" placeholder="e.g. /videos/demo.mp4" class="w-full px-3 py-2 border border-gray-300 text-sm focus:outline-none focus:ring-1 focus:ring-black">
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-2">3D STL Model File URL</label>
          <input type="text" name="stlFile" placeholder="e.g. /models/vase.stl" class="w-full px-3 py-2 border border-gray-300 text-sm focus:outline-none focus:ring-1 focus:ring-black">
        </div>
      </div>

      <!-- Description -->
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-2">Description</label>
        <textarea name="description" rows="4" placeholder="Detailed product description..." class="w-full px-3 py-2 border border-gray-300 text-sm focus:outline-none focus:ring-1 focus:ring-black"></textarea>
      </div>

      <!-- Submit Button -->
      <div class="pt-4 border-t border-gray-200 flex justify-end">
        <button type="submit" class="px-8 py-3 bg-black text-white text-xs font-semibold uppercase tracking-wider hover:opacity-80 transition shadow">
          <i class="fa-solid fa-plus mr-2"></i> Save Product
        </button>
      </div>
    </form>

  </div>
</body>
</html>
