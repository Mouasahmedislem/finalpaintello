        <!-- Paintello Home Button -->
        <a href="/paintello" class="hero-button-zara">
          <img src="/img/logo.png" 
               alt="Paintello Home" 
               class="hero-button-image">
          <span class="hero-button-text">Paintello Home</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== PAINTELLO HOME EDITORIAL LOOKBOOK BANNER ===================== -->
  <section class="bg-slate-900 text-white py-16 px-6 my-12 overflow-hidden relative">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div class="space-y-4">
        <span class="text-xs uppercase tracking-[0.3em] font-light text-amber-300">Collection Exclusive Paintello</span>
        <h2 class="text-3xl sm:text-4xl font-serif italic tracking-wide">The Architectural Collection</h2>
        <p class="text-xs sm:text-sm text-slate-300 font-light leading-relaxed max-w-md">
          Des silhouettes épurées, des textures sculpturales et des teintes minérales conçues pour réinventer vos espaces de vie avec élégance.
        </p>
        <div class="pt-2">
          <a href="/shop" class="inline-block border-b border-white pb-1 text-xs uppercase tracking-[0.2em] font-medium hover:text-amber-300 hover:border-amber-300 transition">
            Découvrir la Collection &rarr;
          </a>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=600&q=80" alt="Paintello Home Mood 1" class="w-full h-64 object-cover rounded shadow-md hover:scale-105 transition-transform duration-500">
        <img src="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&fit=crop&w=600&q=80" alt="Paintello Home Mood 2" class="w-full h-64 object-cover rounded shadow-md mt-6 hover:scale-105 transition-transform duration-500">
      </div>
    </div>
  </section>

  <!-- ===================== ZARA-STYLE PRODUCTS GRID ===================== -->
  <section class="bg-white">
    <h2 class="section-title-zara">New Arrivals</h2>

    <!-- CATEGORY FILTER SWITCHER & CONTROLS BAR -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 max-w-7xl mx-auto px-6 mt-6 mb-4">
      <div class="filter-switcher-zara !mt-0 !mb-0">
        <button type="button" class="filter-btn-zara <%= (typeof selectedCategory !== 'undefined' && selectedCategory === 'all') || typeof selectedCategory === 'undefined' ? 'active' : '' %>" data-filter="all">
          All
        </button>
        <button type="button" class="filter-btn-zara <%= typeof selectedCategory !== 'undefined' && selectedCategory === 'vases' ? 'active' : '' %>" data-filter="vases">
          Vases
        </button>
        <button type="button" class="filter-btn-zara <%= typeof selectedCategory !== 'undefined' && selectedCategory === 'lampshades' ? 'active' : '' %>" data-filter="lampshades">
          Lampshades
        </button>
      </div>

      <!-- SEARCH & SORT CONTROLS -->
      <div class="flex flex-wrap items-center gap-4">
        <!-- SEARCH BAR -->
        <div class="relative w-64">
          <input type="text" id="searchInput" placeholder="Search products..." class="w-full text-xs border border-black px-3 py-2 text-black focus:outline-none placeholder-gray-400 uppercase tracking-wider">
          <div id="searchSuggest" class="hidden absolute left-0 right-0 top-full bg-white border border-black z-30 max-h-60 overflow-y-auto shadow-lg"></div>
        </div>

        <!-- SORTING DROPDOWN -->
        <div class="flex items-center gap-2">
          <label for="sortDropdown" class="text-xs uppercase font-semibold tracking-wider text-gray-500">Sort By:</label>
          <select id="sortDropdown" class="text-xs font-medium uppercase tracking-wider border border-black bg-white px-3 py-2 text-black focus:outline-none cursor-pointer">
            <option value="default">Featured / Newest</option>
            <option value="price-asc">Price: Low to High</option>
            <option value="price-desc">Price: High to Low</option>
          </select>
        </div>
      </div>
    </div>
    
    <div class="products-grid-zara">
      <% paintellos.forEach((product, index) => {
        // Determine category: from field or infer from title/type
        let pCategory = (product.category || product.type || '').toLowerCase();
        if (!pCategory) {
          const titleLower = (product.title || '').toLowerCase();
          if (titleLower.includes('lampshade') || titleLower.includes('lamp') || titleLower.includes('abat-jour') || titleLower.includes('abat jour') || titleLower.includes('eclairage')) {
            pCategory = 'lampshades';
          } else {
            pCategory = 'vases';
          }
        }
        if (pCategory.includes('lamp') || pCategory.includes('shade') || pCategory.includes('abat')) {
          pCategory = 'lampshades';
        } else if (pCategory.includes('vase')) {
          pCategory = 'vases';
        }
      %>
        <article class="product-card-zara fade-in" data-category="<%= pCategory %>" data-price="<%= typeof product.price === 'number' ? product.price : 0 %>" data-order="<%= index %>" style="animation-delay: <%= (index % 6) * 0.1 %>s">
          <div class="product-image-container-zara">
            <!-- STATUS BADGES - ON IMAGE (Based on product.status) -->
            <div class="product-badges-zara">
              <% 
                // Determine which badges to show based on product status
                const badges = [];
                
                // Check for "New" status
                if (product.status && product.status.toLowerCase().includes('new')) {
                  badges.push({ type: 'new', text: 'New' });
                }
                
                // Check for "Promo" status or if oldPrice exists
                if ((product.status && product.status.toLowerCase().includes('promo')) || 
                    (product.oldPrice && product.oldPrice > product.price)) {
                  badges.push({ type: 'promo', text: 'Promo' });
                }
                
                // Check for stock status
                if (product.disponible === true || product.disponible === 'true') {
                  badges.push({ type: 'in-stock', text: 'In Stock' });
                } else if (product.disponible === false || product.disponible === 'false') {
                  badges.push({ type: 'out-of-stock', text: 'Out of Stock' });
                }
                
                // Show badges (limit to 3)
                badges.slice(0, 3).forEach((badge, badgeIndex) => {
              %>
                <span class="badge-zara badge-<%= badge.type %>" style="margin-top: <%= badgeIndex * 40 %>px">
                  <%= badge.text %>
                </span>
              <% }); %>
            </div>

            <!-- Product Images Carousel -->
            <div id="carousel-<%= index %>" class="carousel slide h-full" data-ride="carousel">
              <div class="carousel-inner h-full">
                <% product.image.forEach((img, i) => { %>
                  <div class="carousel-item <%= i === 0 ? 'active' : '' %> h-full">
                    <img class="product-image-zara" src="<%= img %>" alt="<%= product.title %> - Image <%= i + 1 %>">
                  </div>
                <% }) %>
              </div>
              
              <!-- Carousel Indicators -->
              <% if (product.image.length > 1) { %>
                <div class="carousel-indicators-zara">
                  <% product.image.forEach((img, i) => { %>
                    <button type="button" 
                            class="carousel-indicator-zara <%= i === 0 ? 'active' : '' %>" 
                            data-target="#carousel-<%= index %>" 
                            data-slide-to="<%= i %>">
                    </button>
                  <% }) %>
                </div>
              <% } %>
              
              <!-- Carousel Controls -->
              <% if (product.image.length > 1) { %>
                <button class="carousel-control-zara carousel-control-prev-zara" type="button" data-target="#carousel-<%= index %>" data-slide="prev">
                  <span class="carousel-control-icon-zara">
                    <i class="fas fa-chevron-left"></i>
                  </span>
                </button>
                <button class="carousel-control-zara carousel-control-next-zara" type="button" data-target="#carousel-<%= index %>" data-slide="next">
                  <span class="carousel-control-icon-zara">
                    <i class="fas fa-chevron-right"></i>
                  </span>
                </button>
              <% } %>
            </div>

            <!-- VIEW PRODUCT BUTTON - SAME AS BEFORE -->
            <div class="quick-view-overlay">
              <a href="<%= product.href || '/product/' + product._id %>" class="quick-view-btn">
                View Product
              </a>
            </div>
          </div>

          <div class="product-info-zara">
            <div class="flex items-center justify-center gap-2 mb-2">
              <h3 class="product-title-zara !mb-0">
                <a href="<%= product.href || '/product/' + product._id %>" class="hover:opacity-70 transition">
                  <%= product.title %>
                </a>
              </h3>
              <button type="button" class="wishlist-toggle text-gray-400 hover:text-black transition" data-id="<%= product._id %>" data-title="<%= product.title %>" title="Add to Wishlist">
                <i class="fa-regular fa-heart text-sm"></i>
              </button>
            </div>
            
            <div class="product-price-zara">
              <span><%= typeof product.price === 'number' ? product.price.toFixed(2) : product.price %> DA</span>
              <% if (product.oldPrice && product.oldPrice > product.price) { %>
                <span class="product-old-price-zara">
                  <%= typeof product.oldPrice === 'number' ? product.oldPrice.toFixed(2) : product.oldPrice %> DA
                </span>
              <% } %>
            </div>
            
            <!-- Optional: Show status as text below price -->
            <% if (product.status && !product.status.toLowerCase().includes('new') && !product.status.toLowerCase().includes('promo')) { %>
              <div class="text-xs text-gray-500 mt-2 uppercase tracking-wider">
                <%= product.status %>
              </div>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>
    
    <!-- Empty State -->
    <div id="noProductsMsg" class="<%= (!paintellos || paintellos.length === 0) ? '' : 'hidden' %> text-center py-20">
      <p class="text-gray-500 mb-4">No products available in this category at the moment.</p>
      <a href="/" class="inline-block px-6 py-3 bg-black text-white text-sm uppercase tracking-wider hover:opacity-80 transition">
        Continue Shopping
      </a>
    </div>
  </section>

  <!-- ===================== FOOTER ===================== -->
  <footer class="footer-zara">
    <div class="max-w-7xl mx-auto">
      <p>© <%= new Date().getFullYear() %> Paintello Home — All rights reserved</p>
      <div class="mt-4 flex justify-center gap-6 text-xs">
        <a href="/privacy" class="hover:underline">Privacy Policy</a>
        <a href="/terms" class="hover:underline">Terms of Service</a>
        <a href="/contact" class="hover:underline">Contact Us</a>
      </div>
    </div>
  </footer>

  <!-- ===================== SCRIPTS ===================== -->
  <script>
    // User dropdown functionality
    document.addEventListener('DOMContentLoaded', function() {
      const userBtn = document.getElementById('userMenuBtn');
      const userMenu = document.getElementById('userDropdown');
      const mobileBtn = document.getElementById('mobileMenuBtn');
      const mobileMenu = document.getElementById('mobileMenu');

      // Toggle user dropdown
      if (userBtn && userMenu) {
        userBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          userMenu.classList.toggle('hidden');
        });
      }

      // Close dropdown when clicking outside
      document.addEventListener('click', (e) => {
        if (userMenu && !userMenu.contains(e.target) && userBtn && !userBtn.contains(e.target)) {
          userMenu.classList.add('hidden');
        }
      });

      // Toggle mobile menu
      if (mobileBtn && mobileMenu) {
        mobileBtn.addEventListener('click', () => {
          mobileMenu.classList.toggle('hidden');
        });
      }

      // Custom Carousel Functionality
      function initCarousel(carousel) {
        const items = carousel.querySelectorAll('.carousel-item');
        const indicators = carousel.querySelectorAll('.carousel-indicator-zara');
        const prevBtn = carousel.querySelector('[data-slide="prev"]');
        const nextBtn = carousel.querySelector('[data-slide="next"]');
        let currentIndex = 0;
        let autoSlideInterval;

        function showSlide(index) {
          // Update items
          items.forEach((item, i) => {
            item.classList.toggle('active', i === index);
          });
          
          // Update indicators
          indicators.forEach((indicator, i) => {
            indicator.classList.toggle('active', i === index);
          });
          
          currentIndex = index;
        }

        function nextSlide() {
          let newIndex = currentIndex + 1;
          if (newIndex >= items.length) newIndex = 0;
          showSlide(newIndex);
        }

        function prevSlide() {
          let newIndex = currentIndex - 1;
          if (newIndex < 0) newIndex = items.length - 1;
          showSlide(newIndex);
        }

        // Previous button
        if (prevBtn) {
          prevBtn.addEventListener('click', (e) => {
            e.preventDefault();
            prevSlide();
            resetAutoSlide();
          });
        }

        // Next button
        if (nextBtn) {
          nextBtn.addEventListener('click', (e) => {
            e.preventDefault();
            nextSlide();
            resetAutoSlide();
          });
        }

        // Indicators
        indicators.forEach((indicator, index) => {
          indicator.addEventListener('click', () => {
            showSlide(index);
            resetAutoSlide();
          });
        });

        // Auto slide
        function startAutoSlide() {
          if (items.length > 1) {
            autoSlideInterval = setInterval(nextSlide, 4000);
          }
        }

        function resetAutoSlide() {
          clearInterval(autoSlideInterval);
          startAutoSlide();
        }

        // Pause on hover
        carousel.addEventListener('mouseenter', () => {
          clearInterval(autoSlideInterval);
        });

        carousel.addEventListener('mouseleave', startAutoSlide);

        // Initialize
        startAutoSlide();
      }

      // Initialize all carousels
      document.querySelectorAll('.carousel').forEach(carousel => {
        initCarousel(carousel);
      });

      

      // Add hover effect to cards
      document.querySelectorAll('.product-card-zara').forEach(card => {
        card.addEventListener('mouseenter', function() {
          this.style.zIndex = '10';
        });
        
        card.addEventListener('mouseleave', function() {
          this.style.zIndex = '1';
        });
      });

      // Category Filter, Search & Sorting Switcher Logic
      const filterBtns = document.querySelectorAll('.filter-btn-zara');
      const productCards = Array.from(document.querySelectorAll('.product-card-zara'));
      const gridContainer = document.querySelector('.products-grid-zara');
      const sortSelect = document.getElementById('sortDropdown');
      const searchInput = document.getElementById('searchInput');
      const searchSuggest = document.getElementById('searchSuggest');
      const emptyStateMsg = document.getElementById('noProductsMsg');

      function filterAndSortProducts() {
        const activeFilterBtn = document.querySelector('.filter-btn-zara.active');
        const filter = activeFilterBtn ? activeFilterBtn.getAttribute('data-filter') : 'all';
        const sortVal = sortSelect ? sortSelect.value : 'default';
        const query = searchInput ? searchInput.value.trim().toLowerCase() : '';

        let visibleCount = 0;
        productCards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          const titleText = card.querySelector('.product-title-zara')?.innerText?.toLowerCase() || '';

          const matchesCategory = (filter === 'all' || cardCat === filter);
          const matchesSearch = (!query || titleText.includes(query) || cardCat.includes(query));

          if (matchesCategory && matchesSearch) {
            card.style.display = 'block';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (emptyStateMsg) {
          if (visibleCount === 0) {
            emptyStateMsg.classList.remove('hidden');
          } else {
            emptyStateMsg.classList.add('hidden');
          }
        }

        // Sorting
        productCards.sort((a, b) => {
          const priceA = parseFloat(a.getAttribute('data-price')) || 0;
          const priceB = parseFloat(b.getAttribute('data-price')) || 0;
          const orderA = parseInt(a.getAttribute('data-order')) || 0;
          const orderB = parseInt(b.getAttribute('data-order')) || 0;

          if (sortVal === 'price-asc') return priceA - priceB;
          if (sortVal === 'price-desc') return priceB - priceA;
          return orderA - orderB;
        });

        productCards.forEach(card => gridContainer.appendChild(card));
      }

      // Auto-suggest handler
      if (searchInput && searchSuggest) {
        searchInput.addEventListener('input', function() {
          const query = this.value.trim().toLowerCase();
          filterAndSortProducts();

          if (!query) {
            searchSuggest.classList.add('hidden');
            searchSuggest.innerHTML = '';
            return;
          }

          const matches = productCards.filter(card => {
            const title = card.querySelector('.product-title-zara')?.innerText || '';
            return title.toLowerCase().includes(query);
          }).slice(0, 5);

          if (matches.length > 0) {
            searchSuggest.innerHTML = matches.map(m => {
              const title = m.querySelector('.product-title-zara')?.innerText || 'Product';
              const price = m.querySelector('.product-price-zara')?.innerText || '';
              const link = m.querySelector('a')?.getAttribute('href') || '#';
              return `<a href="${link}" class="block px-3 py-2 border-b border-gray-100 hover:bg-gray-50 flex items-center justify-between text-xs uppercase font-medium"><span>${title}</span> <span class="text-gray-500">${price}</span></a>`;
            }).join('');
            searchSuggest.classList.remove('hidden');
          } else {
            searchSuggest.classList.add('hidden');
          }
        });

        document.addEventListener('click', function(e) {
          if (!searchInput.contains(e.target) && !searchSuggest.contains(e.target)) {
            searchSuggest.classList.add('hidden');
          }
        });
      }

      if (sortSelect) {
        sortSelect.addEventListener('change', filterAndSortProducts);
      }

      filterBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          filterBtns.forEach(b => b.classList.remove('active'));
          this.classList.add('active');
          filterAndSortProducts();
        });
      });

      // Wishlist / Favorites Logic
      function getWishlist() {
        try {
          return JSON.parse(localStorage.getItem('paintello_wishlist')) || [];
        } catch (e) {
          return [];
        }
      }

      function saveWishlist(list) {
        localStorage.setItem('paintello_wishlist', JSON.stringify(list));
        updateWishlistUI();
      }

      function updateWishlistUI() {
        const list = getWishlist();
        const badge = document.getElementById('wishlistBadge');
        if (badge) {
          badge.innerText = list.length;
          if (list.length > 0) badge.classList.remove('hidden');
          else badge.classList.add('hidden');
        }

        document.querySelectorAll('.wishlist-toggle').forEach(btn => {
          const id = btn.getAttribute('data-id');
          const icon = btn.querySelector('i');
          if (list.includes(id)) {
            icon.classList.remove('fa-regular');
            icon.classList.add('fa-solid', 'text-red-500');
          } else {
            icon.classList.remove('fa-solid', 'text-red-500');
            icon.classList.add('fa-regular');
          }
        });
      }

      document.querySelectorAll('.wishlist-toggle').forEach(btn => {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          const id = this.getAttribute('data-id');
          let list = getWishlist();
          if (list.includes(id)) {
            list = list.filter(item => item !== id);
          } else {
            list.push(id);
          }
          saveWishlist(list);
        });
      });

      updateWishlistUI();

      // Initial run
      filterAndSortProducts();
    });

   
  </script>

  <!-- FontAwesome -->
  <script src="https://kit.fontawesome.com/a2d9b6b9f4.js" crossorigin="anonymous"></script>
</body>
</html>
