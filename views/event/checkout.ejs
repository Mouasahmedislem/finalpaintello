                    </div>
                  </div>
                  <div>
                    <label class="label" for="commune">Commune</label>
                    <div class="field-wrap">
                      <i class="fa-solid fa-city field-icon"></i>
                      <select id="commune" name="commune" required class="input">
                        <option value="">Sélectionnez d'abord la wilaya</option>
                      </select>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Payment Method Selection -->
              <div>
                <h3 class="text-sm font-medium uppercase tracking-wide mb-6 border-b pb-2 flex items-center gap-3">
                  <span class="section-num">3</span> Mode de paiement
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                  
                  <!-- COD Card (now first & checked) -->
                  <label class="payment-option zara-card p-4 cursor-pointer border border-gray-300 hover:border-black transition-all relative" for="payCOD">
                    <input type="radio" id="payCOD" name="paymentMethod" value="cod" class="hidden peer" checked>
                    <div class="flex items-start gap-3">
                      <div class="text-2xl text-gray-700 mt-1 flex-shrink-0">
                        <i class="fa-solid fa-money-bill-wave"></i>
                      </div>
                      <div class="flex-1">
                        <span class="text-sm font-medium block">Paiement à la livraison</span>
                        <p class="text-xs text-gray-500 mt-1">Payez en espèces</p>
                      </div>
                      <div class="check-icon hidden absolute top-3 right-3 text-black">
                        <i class="fa-solid fa-circle-check text-lg"></i>
                      </div>
                    </div>
                  </label>

                  <!-- CIB Card -->
                  <label class="payment-option zara-card p-4 cursor-pointer border border-gray-300 hover:border-black transition-all relative" for="payCIB">
                    <input type="radio" id="payCIB" name="paymentMethod" value="chargily" data-card="cib" class="hidden peer">
                    <div class="flex items-start gap-3">
                      <img src="/favicon/cib.png" alt="CIB" class="h-10 w-auto mt-1 flex-shrink-0">
                      <div class="flex-1">
                        <span class="text-sm font-medium block">Carte CIB</span>
                        <p class="text-xs text-gray-500 mt-1">Paiement sécurisé</p>
                      </div>
                      <div class="check-icon hidden absolute top-3 right-3 text-black">
                        <i class="fa-solid fa-circle-check text-lg"></i>
                      </div>
                    </div>
                  </label>

                  <!-- Edahabia Card -->
                  <label class="payment-option zara-card p-4 cursor-pointer border border-gray-300 hover:border-black transition-all relative" for="payEdahabia">
                    <input type="radio" id="payEdahabia" name="paymentMethod" value="chargily" data-card="edahabia" class="hidden peer">
                    <div class="flex items-start gap-3">
                      <img src="/favicon/eddahabia.png" alt="Edahabia" class="h-10 w-auto mt-1 flex-shrink-0">
                      <div class="flex-1">
                        <span class="text-sm font-medium block">Carte Edahabia</span>
                        <p class="text-xs text-gray-500 mt-1">Paiement sécurisé</p>
                      </div>
                      <div class="check-icon hidden absolute top-3 right-3 text-black">
                        <i class="fa-solid fa-circle-check text-lg"></i>
                      </div>
                    </div>
