                </div>
              </div>

              <!-- Hidden fields for shipping -->
              <input type="hidden" id="shippingFee" name="shippingFee" value="0">
              <input type="hidden" id="deliveryDelay" name="deliveryDelay" value="">
              <input type="hidden" id="totalPriceFinal" name="totalPriceFinal" value="<%= totalPrice %>">
            </form>
          </div>
        </div>

        <!-- Right Column - Order Summary -->
        <div class="md:col-span-1">
          <div class="zara-card p-8 sticky top-8">
            <h3 class="text-sm font-medium uppercase tracking-wide mb-6 border-b pb-2">Résumé de la commande</h3>
            <!-- discount logic unchanged -->
            <% 
              let hasDiscount = false;
              let discountAmount = 0;
              let totalBeforeDiscount = 0;
              let cartItems = [];
              if (session.cart && session.cart.items) {
                cartItems = Object.values(session.cart.items);
                cartItems.forEach(item => {
                  const product = item.item || {};
                  const fallbackUnitPrice = item.qty ? (item.price || 0) / item.qty : (product.price || 0);
                  const originalPrice = item.originalPrice || product.price || fallbackUnitPrice;
                  if (item.isDiscounted) {
                    hasDiscount = true;
                    const discount = originalPrice - (item.unitPrice || fallbackUnitPrice);
                    discountAmount += discount * item.qty;
                  }
                  totalBeforeDiscount += originalPrice * item.qty;
                });
              }
              const totalAfterDiscount = totalPrice - discountAmount;
            %>

            <!-- Cart items -->
            <% if (cartItems.length > 0) { %>
              <div class="space-y-4 mb-6 pb-6 border-b border-gray-100 max-h-80 overflow-y-auto pr-1">
                <% cartItems.forEach(function(item) {
                     const product = item.item || {};
                     const img = Array.isArray(product.image) && product.image[0] ? product.image[0] : '/img/logo.png';
                     const title = product.title || 'Article';
                     const qty = item.qty || 1;
                     const fallbackUnitPrice = qty ? (item.price || 0) / qty : (product.price || 0);
                     const unit = item.unitPrice || fallbackUnitPrice;
                     const originalUnit = item.originalPrice || product.price || unit;
                     const lineTotal = unit * qty;
                     const lineOriginal = originalUnit * qty;
                %>
                  <div class="flex items-center gap-3">
                    <div class="relative flex-shrink-0">
                      <img src="<%= img %>" alt="<%= title %>" class="w-14 h-14 object-cover rounded border border-gray-200 bg-gray-50">
                      <span class="absolute -top-2 -right-2 bg-black text-white text-[10px] font-medium w-5 h-5 rounded-full flex items-center justify-center"><%= qty %></span>
                    </div>
                    <div class="flex-1 min-w-0">
                      <p class="text-sm font-medium truncate"><%= title %></p>
                      <% if (item.isDiscounted && lineOriginal > lineTotal) { %>
                        <p class="text-xs text-gray-400 line-through"><%= lineOriginal.toFixed(2) %> DA</p>
                      <% } %>
                    </div>
                    <div class="text-sm font-medium flex-shrink-0"><%= lineTotal.toFixed(2) %> DA</div>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <div class="mb-6 pb-6 border-b border-gray-100 text-center">
                <p class="text-sm text-gray-500">Votre panier est vide.</p>
                <a href="/shop" class="text-xs uppercase tracking-wide underline text-gray-700 hover:text-black">Voir la boutique</a>
              </div>
            <% } %>
            <div class="space-y-4 mb-6">
              <% if (hasDiscount && discountAmount > 0) { %>
                <div class="flex justify-between items-center">
                  <div class="text-xs text-gray-600 uppercase tracking-wide">Total original</div>
                  <div class="text-sm font-medium line-through text-gray-400"><%= totalBeforeDiscount.toFixed(2) %> DA</div>
                </div>
                <div class="flex justify-between items-center">
                  <div class="text-xs text-green-600 uppercase tracking-wide"><i class="fas fa-tag mr-1"></i>Économies (-30%)</div>
                  <div class="text-sm font-medium text-green-600">-<%= discountAmount.toFixed(2) %> DA</div>
                </div>
              <% } %>
              <div class="flex justify-between items-center">
                <div class="text-xs text-gray-600 uppercase tracking-wide">Total produits</div>
                <div class="text-sm font-medium" id="baseTotal"><%= hasDiscount ? totalAfterDiscount.toFixed(2) : totalPrice %> DA</div>
              </div>
              <div class="flex justify-between items-center">
                <div class="text-xs text-gray-600 uppercase tracking-wide">Frais de livraison</div>
                <div class="text-sm text-gray-700" id="shippingDisplay">—</div>
              </div>
              <div class="flex justify-between items-center">
                <div class="text-xs text-gray-600 uppercase tracking-wide">Délai estimé</div>
                <div class="text-xs text-gray-700" id="delayDisplay">—</div>
              </div>
            </div>
            <!-- Coupon Code Section -->
            <div class="border-t border-gray-200 pt-4 mb-6">
              <label class="block text-xs font-semibold uppercase tracking-wider text-gray-600 mb-2">Code Promo / Réduction</label>
              <div class="flex gap-2">
                <input type="text" id="couponInput" name="couponCode" form="checkoutForm" placeholder="EX: SUMMER10" class="flex-1 px-3 py-2 text-xs border border-gray-300 rounded uppercase focus:outline-none focus:ring-1 focus:ring-black">
                <button type="button" id="applyCouponBtn" class="px-4 py-2 bg-slate-900 text-white text-xs font-semibold uppercase tracking-wider rounded hover:bg-slate-800 transition">
                  Appliquer
                </button>
              </div>
              <p id="couponMsg" class="text-xs mt-2 hidden"></p>
            </div>

            <div class="border-t border-gray-200 pt-4 mb-6">
              <div class="flex justify-between items-center">
                <div class="text-sm font-medium uppercase tracking-wide">Total à payer</div>
                <div class="text-lg font-medium" id="totalDisplay"><%= hasDiscount ? totalAfterDiscount : totalPrice %> DA</div>
              </div>
            </div>

            <script>
              document.addEventListener('DOMContentLoaded', function() {
                const couponBtn = document.getElementById('applyCouponBtn');
                const couponInput = document.getElementById('couponInput');
                const couponMsg = document.getElementById('couponMsg');

                if (couponBtn) {
                  couponBtn.addEventListener('click', async function() {
                    const code = (couponInput.value || '').trim();
                    if (!code) return;

                    const originalBasePrice = window.originalBasePrice || parseFloat('<%= hasDiscount ? totalAfterDiscount : totalPrice %>') || 0;

                    try {
                      const res = await fetch('/validate-coupon', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ code, cartTotal: originalBasePrice })
                      });
                      const data = await res.json();

                      if (data.valid) {
                        couponMsg.classList.remove('hidden', 'text-rose-600');
                        couponMsg.classList.add('text-emerald-600');
                        couponMsg.innerText = data.message;

                        const discount = data.discountAmount || 0;
                        if (typeof window.applyCouponDiscount === 'function') {
                          window.applyCouponDiscount(discount);
                        }
                      } else {
                        couponMsg.classList.remove('hidden', 'text-emerald-600');
                        couponMsg.classList.add('text-rose-600');
                        couponMsg.innerText = data.message || 'Code promo invalide.';
                        if (typeof window.applyCouponDiscount === 'function') {
                          window.applyCouponDiscount(0);
                        }
                      }
                    } catch(err) {
                      console.error('Coupon validation error', err);
                    }
                  });
                }
              });
            </script>
