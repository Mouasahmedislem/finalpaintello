}

/* ===== FIXED ZARA-STYLE MODAL STYLES ===== */

/* Modal Backdrop */
.notify-modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99999;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}

.notify-modal-backdrop.active {
  opacity: 1;
  visibility: visible;
}

/* Modal Content */
.notify-modal-content {
  background-color: white;
  width: 90%;
  max-width: 420px;
  transform: translateY(-20px);
  opacity: 0;
  transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1), opacity 0.4s ease;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
}

.notify-modal-backdrop.active .notify-modal-content {
  transform: translateY(0);
  opacity: 1;
}

/* Modal Header */
.modal-header {
  padding: 24px 24px 16px;
  border-bottom: 1px solid #e5e7eb;
}

.modal-header h3 {
  font-size: 1.125rem;
  font-weight: 400;
  letter-spacing: 0.5px;
  color: #111827;
  margin-bottom: 4px;
}

.modal-header p {
  font-size: 0.875rem;
  color: #6b7280;
}

/* Modal Body */
.modal-body {
  padding: 24px;
}

/* Modal Footer */
.modal-footer {
  padding: 16px 24px 24px;
  border-top: 1px solid #e5e7eb;
  display: flex;
  gap: 12px;
}

/* Input Styles */
.modal-input {
  width: 100%;
  padding: 0 0 10px 0;
  border: none;
  border-bottom: 1px solid #d1d5db;
  background: transparent;
  font-size: 0.875rem;
  color: #111827;
  transition: border-color 0.3s ease;
}

.modal-input:focus {
  outline: none;
  border-bottom-color: #111827;
}

.modal-input::placeholder {
  color: #9ca3af;
}

/* Label Styles */
.input-label {
  display: block;
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.5px;
  color: #374151;
  margin-bottom: 8px;
  text-transform: uppercase;
}

/* Checkbox Styles */
.consent-checkbox {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-top: 20px;
}

.consent-checkbox input[type="checkbox"] {
  width: 16px;
  height: 16px;
  margin-top: 2px;
  accent-color: #111827;
}

.consent-checkbox label {
  font-size: 0.75rem;
  color: #4b5563;
  line-height: 1.5;
}

.consent-checkbox a {
  color: #111827;
  text-decoration: underline;
}

.consent-checkbox a:hover {
  color: #374151;
}

/* Button Styles */
.modal-btn {
  flex: 1;
  padding: 12px 20px;
  font-size: 0.875rem;
  font-weight: 500;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  border: 1px solid #111827;
  background: transparent;
  color: #111827;
  cursor: pointer;
  transition: all 0.3s ease;
}

.modal-btn:hover {
  background-color: #111827;
  color: white;
}

.modal-btn.submit {
  background-color: #111827;
  color: white;
}

.modal-btn.submit:hover {
  background-color: #374151;
  border-color: #374151;
}

/* Loading Spinner */
.loading-spinner {
  display: inline-block;
  width: 16px;
  height: 16px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  border-top-color: white;
  animation: spin 1s linear infinite;
  margin-left: 8px;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* Message Styles */
.message {
  padding: 12px 16px;
  border-radius: 4px;
  margin-top: 16px;
  display: flex;
  align-items: flex-start;
  gap: 12px;
}

.message.success {
  background-color: #f0fdf4;
  border: 1px solid #bbf7d0;
}

.message.error {
  background-color: #fef2f2;
  border: 1px solid #fecaca;
}

.message-icon {
  flex-shrink: 0;
  margin-top: 2px;
}

.message-text {
  font-size: 0.875rem;
}

.message.success .message-text {
  color: #166534;
}

.message.error .message-text {
  color: #991b1b;
}

/* Close Button */
.modal-close-btn {
  position: absolute;
  top: 16px;
  right: 16px;
  background: transparent;
  border: none;
  padding: 8px;
  cursor: pointer;
  color: #6b7280;
  transition: color 0.3s ease;
  z-index: 10;
}

.modal-close-btn:hover {
  color: #111827;
}

/* Responsive */
@media (max-width: 640px) {
  .notify-modal-content {
    width: 95%;
    margin: 0 16px;
  }
  
  .modal-footer {
    flex-direction: column;
  }
}
