  <!-- Zara-style Notification Modal Script -->
<script>
// WORKING NOTIFICATION MODAL SCRIPT WITH MONGODB SAVING
document.addEventListener('DOMContentLoaded', function() {
  const openNotifyModal = document.getElementById('openNotifyModal');
  const notifyModal = document.getElementById('notifyModal');
  const modalCloseBtn = document.getElementById('modalCloseBtn');
  const cancelNotify = document.getElementById('cancelNotify');
  const notifyForm = document.getElementById('notifyForm');
  const submitNotify = document.getElementById('submitNotify');
  const submitText = document.getElementById('submitText');
  const loadingSpinner = document.getElementById('loadingSpinner');
  const successMessage = document.getElementById('successMessage');
  const errorMessage = document.getElementById('errorMessage');
  const successText = document.getElementById('successText');
  const errorText = document.getElementById('errorText');
  
  // Open modal when clicking "Me notifier" button
  if (openNotifyModal) {
    openNotifyModal.addEventListener('click', function() {
      // Make sure modal exists before trying to open it
      if (notifyModal) {
        notifyModal.classList.add('active');
        document.body.style.overflow = 'hidden';
      } else {
        console.error('Notification modal not found!');
        alert('Le système de notification n\'est pas disponible pour le moment.');
      }
    });
  }
  
  // Close modal function
  function closeModal() {
    if (notifyModal) {
      notifyModal.classList.remove('active');
      document.body.style.overflow = '';
      
      // Reset form and messages
      setTimeout(() => {
        if (notifyForm) notifyForm.reset();
        if (successMessage) {
          successMessage.classList.add('hidden');
          successMessage.classList.remove('hidden');
        }
        if (errorMessage) {
          errorMessage.classList.add('hidden');
          errorMessage.classList.remove('hidden');
        }
      }, 300);
    }
  }
  
  // Close modal with close button
  if (modalCloseBtn) {
    modalCloseBtn.addEventListener('click', closeModal);
  }
  
  // Close modal with cancel button
  if (cancelNotify) {
    cancelNotify.addEventListener('click', closeModal);
  }
  
  // Close modal when clicking on backdrop
  if (notifyModal) {
    notifyModal.addEventListener('click', function(e) {
      if (e.target === notifyModal) {
        closeModal();
      }
    });
  }
  
  // Close modal with ESC key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && notifyModal && notifyModal.classList.contains('active')) {
      closeModal();
    }
  });
  
  // Form submission - ACTUAL API CALL
  if (notifyForm && submitNotify) {
    notifyForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const email = document.getElementById('email').value.trim();
      const phone = document.getElementById('phone').value.trim();
      const productId = document.getElementById('productId').value;
      const consent = document.getElementById('consent').checked;
      
      // Validation
      if (!consent) {
        showError('Veuillez accepter les conditions de notification');
        return;
      }
      
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        showError('Format d\'email invalide');
        return;
      }
      
      // Show loading state
      submitNotify.disabled = true;
      submitText.textContent = 'En cours...';
      loadingSpinner.classList.remove('hidden');
      errorMessage.classList.add('hidden');
      successMessage.classList.add('hidden');
      
      try {
        // ✅ ACTUAL API CALL TO SAVE TO MONGODB
        const response = await fetch(`/notify-me/${productId}`, {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ 
            email: email,
            phone: phone || null  // Send phone even if empty
          })
        });
        
        const data = await response.json();
        
        if (data.success) {
          showSuccess(data.message);
          // Clear form on success
          notifyForm.reset();
          // Auto-close after 3 seconds
          setTimeout(() => {
            closeModal();
          }, 3000);
        } else {
          showError(data.message || 'Une erreur est survenue');
        }
      } catch (error) {
        console.error('Notification API error:', error);
        showError('Erreur de connexion au serveur. Veuillez réessayer.');
      } finally {
        // Reset button state
        submitNotify.disabled = false;
        submitText.textContent = 'Confirmer';
        loadingSpinner.classList.add('hidden');
      }
    });
  }
  
  // Show success message
  function showSuccess(message) {
    if (successText && successMessage) {
      successText.textContent = message;
      successMessage.classList.remove('hidden');
      errorMessage.classList.add('hidden');
    }
  }
  
  // Show error message
  function showError(message) {
    if (errorText && errorMessage) {
      errorText.textContent = message;
      errorMessage.classList.remove('hidden');
      successMessage.classList.add('hidden');
    }
  }
  
  // Real-time email validation (optional)
  const emailInput = document.getElementById('email');
  if (emailInput) {
    emailInput.addEventListener('blur', function() {
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (this.value && !emailRegex.test(this.value)) {
        this.style.borderBottomColor = '#ef4444';
      } else {
        this.style.borderBottomColor = '#d1d5db';
      }
    });
  }
  
  // Debug: Log to console when modal opens
  console.log('Notification system loaded');
  console.log('Open button:', openNotifyModal ? 'Found' : 'Not found');
  console.log('Modal:', notifyModal ? 'Found' : 'Not found');
  console.log('Form:', notifyForm ? 'Found' : 'Not found');
});
</script>

