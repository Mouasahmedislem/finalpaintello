  <script>
  !function(f,b,e,v,n,t,s)
  {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
  n.callMethod.apply(n,arguments):n.queue.push(arguments)};
  if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
  n.queue=[];t=b.createElement(e);t.async=!0;
  t.src=v;s=b.getElementsByTagName(e)[0];
  s.parentNode.insertBefore(t,s)}(window, document,'script',
  'https://connect.facebook.net/en_US/fbevents.js');

  // Initialize pixel
  fbq('init', '<%= process.env.FB_PIXEL_ID %>', {
    <% if (user && user.email) { %>em: <%- JSON.stringify(user.email) %>,<% } %>
    <% if (user && user.firstName) { %>fn: <%- JSON.stringify(user.firstName) %>,<% } %>
    <% if (user && user.lastName) { %>ln: <%- JSON.stringify(user.lastName) %>,<% } %>
    <% if (user && user.numero) { %>ph: <%- JSON.stringify(user.numero) %>,<% } %>
  });

  // ✅ Track PageView with server-side event ID
  fbq('track', 'PageView', {}, {
    eventID: '<%= metaEventIdPageView %>'
  });
  

  // Track ViewContent with server-side event ID
setTimeout(function() {
  if (typeof fbq !== 'undefined') {
    // ✅ Same Event ID as CAPI
    const serverEventId = '<%= metaEventIdView %>';
    
    fbq('track', 'ViewContent', {
      content_name: <%- JSON.stringify(producthome.title) %>,
      content_ids: ['<%= producthome._id %>'],
      content_type: 'home_decor',
      value: <%= producthome.price %>,
      currency: 'DZD',
      contents: [{
        id: '<%= producthome._id %>',
        quantity: 1,
        item_price: <%= producthome.price %>
      }]
    }, {
      eventID: serverEventId // ✅ Same ID as CAPI
    });
    
    console.log('🎯 ViewContent Event ID:', serverEventId);
  }
}, 2000);

  // GA4 DataLayer view_item Push (Matching GTM variables: currency, price, productId, productName)
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({
    event: 'view_item',
    currency: 'DZD',
    price: <%= producthome.price %>,
    productId: '<%= producthome._id %>',
    productName: <%- JSON.stringify(producthome.title) %>,
    item_id: '<%= producthome._id %>',
    item_name: <%- JSON.stringify(producthome.title) %>
  });
  </script>
  <noscript>
    <img height="1" width="1" style="display:none" 
         src="https://www.facebook.com/tr?id=<%= process.env.FB_PIXEL_ID %>&ev=PageView&noscript=1"/>
  </noscript>
  <% } %>

