<style>

/* ===== ZARA-STYLE HERO SECTION STYLES ===== */
.hero-zara {
  position: relative;
  height: 90vh;
  overflow: hidden;
  margin-top: -80px;
}

.hero-overlay-zara {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.2), rgba(0,0,0,0.5));
  z-index: 2;
}

.hero-content-zara {
  /* Previously relied on the Tailwind classes on this element (absolute inset-0
     flex flex-col items-center justify-center) to actually center this block -
     that only worked because the old Play CDN injected its styles last, letting
     Tailwind win the cascade over this same-specificity custom rule. Now that
     Tailwind is a normal stylesheet loaded earlier in <head>, this rule must not
     depend on winning that race - so its own positioning is spelled out here. */
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 3;
  color: white;
  padding: 0 20px;
}

.hero-title-zara {
  font-size: 3.5rem;
  font-weight: 300;
  letter-spacing: 2px;
  margin-bottom: 1rem;
  font-family: 'Helvetica Neue', Arial, sans-serif;
}

.hero-subtitle-zara {
  font-size: 1rem;
  font-weight: 300;
  letter-spacing: 2px;
  text-transform: uppercase;
  opacity: 0.9;
  max-width: 600px;
  margin: 0 auto;
  font-family: 'Helvetica Neue', Arial, sans-serif;
}

/* FIXED BUTTONS CONTAINER */
.hero-buttons-container {
  display: flex;
  flex-direction: row;
  gap: 20px;
  margin-top: 40px;
  width: 100%;
  max-width: 500px;
  margin-left: auto;
  margin-right: auto;
}

/* FIXED BUTTON STYLES - SAME SIZE */
.hero-button-zara {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  background: white;
  border: 1px solid rgba(255, 255, 255, 0.3);
  padding: 14px 20px;
  min-width: 0;
  transition: all 0.3s ease;
  text-decoration: none;
  border-radius: 0;
}

.hero-button-zara:hover {
  background: rgba(255, 255, 255, 0.95);
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
}

.hero-button-image {
  width: 32px;
  height: 32px;
  object-fit: contain;
  flex-shrink: 0;
}

.hero-button-text {
  font-size: 0.875rem;
  font-weight: 500;
  color: #111;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-family: 'Helvetica Neue', Arial, sans-serif;
}

/* Video containers for Zara hero */
.video-img-container {
  position: absolute;
  inset: 0;
  z-index: 1;
}

.video-desktop { display: none; }
.video-mobile { display: block; }

@media (min-width: 768px) {
  .video-desktop { display: block; }
  .video-mobile { display: none; }
}

/* Responsive adjustments for Zara hero */
@media (max-width: 768px) {
  .hero-zara {
    height: calc(100vh - 70px);
  }
  
  .hero-buttons-container {
    flex-direction: column;
    gap: 15px;
    max-width: 300px;
  }
  
  .hero-button-zara {
    padding: 16px 20px;
    width: 100%;
  }
  
  .hero-title-zara {
    font-size: 2.5rem;
  }
  
  .hero-subtitle-zara {
    font-size: 0.875rem;
    padding: 0 10px;
  }
  
  .hero-button-image {
    width: 28px;
    height: 28px;
  }
  
  .hero-button-text {
    font-size: 0.813rem;
  }
}

@media (max-width: 480px) {
  .hero-title-zara {
    font-size: 2rem;
  }
  
  .hero-subtitle-zara {
    font-size: 0.75rem;
  }
  
  .hero-buttons-container {
    max-width: 280px;
  }
  
  .hero-button-zara {
    padding: 14px 16px;
  }
}

