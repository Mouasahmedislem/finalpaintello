<!-- Interaction scripts (lightbox, thumbnails, tabs, qty, addToCart tracking) -->
  <script>
    document.addEventListener('DOMContentLoaded', function(){
      // ---------- Image Slider Functionality ----------
      const slides = document.querySelectorAll('.slider-img');
      const prev = document.getElementById('prevSlide');
      const next = document.getElementById('nextSlide');
      const thumbnails = document.querySelectorAll('.thumbnail');
      const imageSlider = document.getElementById('imageSlider');
      const zoomLens = document.getElementById('zoomLens');
      let currentSlide = 0;

      function showSlide(index) {
        // Validate index
        if (index < 0) index = slides.length - 1;
        if (index >= slides.length) index = 0;
        
        // Hide all slides
        slides.forEach(slide => {
          slide.classList.remove('opacity-100');
          slide.classList.add('opacity-0');
        });
        
        // Show selected slide
        slides[index].classList.remove('opacity-0');
        slides[index].classList.add('opacity-100');
        
        // Update active thumbnail
        thumbnails.forEach(thumb => {
          thumb.classList.remove('active', 'border-[color:var(--accent)]');
        });
        
        if (thumbnails[index]) {
          thumbnails[index].classList.add('active', 'border-[color:var(--accent)]');
        }
        
        currentSlide = index;
      }

      function nextSlide() {
        let nextIndex = (currentSlide + 1) % slides.length;
        showSlide(nextIndex);
      }

      function prevSlide() {
        let prevIndex = (currentSlide - 1 + slides.length) % slides.length;
        showSlide(prevIndex);
      }

      // Event listeners for slider arrows
      if (prev) prev.addEventListener('click', prevSlide);
      if (next) next.addEventListener('click', nextSlide);

      // Event listeners for thumbnails
      thumbnails.forEach(thumb => {
        thumb.addEventListener('click', function() {
          const index = parseInt(this.getAttribute('data-index'));
          showSlide(index);
        });
      });

      // ---------- Hover zoom lens (desktop with a real mouse only - skipped on touch) ----------
      const supportsHoverZoom = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      const ZOOM_LENS_FACTOR = 2.5;

      if (supportsHoverZoom && imageSlider && zoomLens) {
        imageSlider.addEventListener('mousemove', function(e) {
          if (mDown) return; // don't fight with an active drag/swipe
          const activeImg = slides[currentSlide];
          if (!activeImg) return;
          const rect = imageSlider.getBoundingClientRect();
          const x = Math.min(rect.width, Math.max(0, e.clientX - rect.left));
          const y = Math.min(rect.height, Math.max(0, e.clientY - rect.top));
          const xPct = (x / rect.width) * 100;
          const yPct = (y / rect.height) * 100;

          zoomLens.style.backgroundImage = `url("${activeImg.getAttribute('src')}")`;
          zoomLens.style.backgroundSize = `${rect.width * ZOOM_LENS_FACTOR}px ${rect.height * ZOOM_LENS_FACTOR}px`;
          zoomLens.style.backgroundPosition = `${xPct}% ${yPct}%`;

          const lensSize = zoomLens.offsetWidth || 170;
          const lensX = Math.min(rect.width - lensSize / 2, Math.max(lensSize / 2, x));
          const lensY = Math.min(rect.height - lensSize / 2, Math.max(lensSize / 2, y));
          zoomLens.style.left = (lensX - lensSize / 2) + 'px';
          zoomLens.style.top = (lensY - lensSize / 2) + 'px';
          zoomLens.classList.add('active');
        });

        imageSlider.addEventListener('mouseleave', function() {
          zoomLens.classList.remove('active');
        });
      }

      // ---------- Enhanced Lightbox Functionality (real pinch / scroll / drag zoom) ----------
      const lightbox = document.getElementById('lightbox');
      const lightboxImage = document.getElementById('lightboxImage');
      const lightboxViewport = document.getElementById('lightboxViewport');
      const lightboxClose = document.getElementById('lightboxClose');
      const lightboxPrev = document.getElementById('lightboxPrev');
      const lightboxNext = document.getElementById('lightboxNext');
      const openLightboxBtn = document.getElementById('openLightboxBtn');
      const lbZoomIn = document.getElementById('lightboxZoomIn');
      const lbZoomOut = document.getElementById('lightboxZoomOut');
      const lbZoomReset = document.getElementById('lightboxZoomReset');
      const lbZoomHint = document.getElementById('lightboxZoomHint');

      const ZOOM_MIN = 1, ZOOM_MAX = 4;
      let zoomScale = 1, panX = 0, panY = 0, hintTimer = null;

      function applyTransform(withTransition) {
        lightboxImage.style.transition = withTransition ? '' : 'none';
        lightboxImage.style.transform = 'translate(' + panX + 'px, ' + panY + 'px) scale(' + zoomScale + ')';
        lightboxImage.classList.toggle('zoomed', zoomScale > 1);
      }

      function clampPan() {
        if (!lightboxViewport) return;
        const rect = lightboxViewport.getBoundingClientRect();
        const maxX = Math.max(0, (rect.width * (zoomScale - 1)) / 2);
        const maxY = Math.max(0, (rect.height * (zoomScale - 1)) / 2);
        panX = Math.min(maxX, Math.max(-maxX, panX));
        panY = Math.min(maxY, Math.max(-maxY, panY));
      }

      function setZoom(newScale, withTransition) {
        zoomScale = Math.min(ZOOM_MAX, Math.max(ZOOM_MIN, newScale));
        if (zoomScale === 1) { panX = 0; panY = 0; }
        clampPan();
        applyTransform(withTransition !== false);
      }

      function resetZoom() {
        setZoom(1, true);
      }

      function showZoomHint() {
        if (!lbZoomHint) return;
        lbZoomHint.classList.add('visible');
        clearTimeout(hintTimer);
        hintTimer = setTimeout(function() { lbZoomHint.classList.remove('visible'); }, 2500);
      }

      function handleDoubleActivate() {
        if (zoomScale > 1) resetZoom();
        else setZoom(2.5, true);
      }

      function openLightbox() {
        const currentImageSrc = slides[currentSlide].getAttribute('src');
        lightboxImage.setAttribute('src', currentImageSrc);
        resetZoom();
        lightbox.classList.add('active');
        document.body.style.overflow = 'hidden';
        showZoomHint();
      }

      function closeLightbox() {
        lightbox.classList.remove('active');
        document.body.style.overflow = '';
        resetZoom();
      }

      function updateLightboxImage() {
        const currentImageSrc = slides[currentSlide].getAttribute('src');
        lightboxImage.setAttribute('src', currentImageSrc);
        resetZoom();
      }

      if (openLightboxBtn) {
        openLightboxBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          openLightbox();
        });
      }

      if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);

      if (lightboxPrev) {
        lightboxPrev.addEventListener('click', function() {
          prevSlide();
          updateLightboxImage();
        });
      }

      if (lightboxNext) {
        lightboxNext.addEventListener('click', function() {
          nextSlide();
          updateLightboxImage();
        });
      }

      if (lbZoomIn) lbZoomIn.addEventListener('click', function() { setZoom(zoomScale + 1, true); });
      if (lbZoomOut) lbZoomOut.addEventListener('click', function() { setZoom(zoomScale - 1, true); });
      if (lbZoomReset) lbZoomReset.addEventListener('click', resetZoom);

      // Close on backdrop click
      lightbox.addEventListener('click', function(e) {
        if (e.target === lightbox) closeLightbox();
      });

      // Keyboard: Esc closes, arrows navigate (only while not zoomed), +/- zoom
      document.addEventListener('keydown', function(e) {
        if (!lightbox.classList.contains('active')) return;
        if (e.key === 'Escape') closeLightbox();
        else if (e.key === 'ArrowLeft' && zoomScale === 1) { prevSlide(); updateLightboxImage(); }
        else if (e.key === 'ArrowRight' && zoomScale === 1) { nextSlide(); updateLightboxImage(); }
        else if (e.key === '+' || e.key === '=') setZoom(zoomScale + 1, true);
        else if (e.key === '-') setZoom(zoomScale - 1, true);
      });

      // Scroll wheel to zoom (desktop)
      if (lightboxViewport) {
        lightboxViewport.addEventListener('wheel', function(e) {
          e.preventDefault();
          setZoom(zoomScale + (e.deltaY < 0 ? 0.4 : -0.4), false);
        }, { passive: false });
      }

      // Double-click to toggle zoom (desktop)
      if (lightboxImage) {
        lightboxImage.addEventListener('dblclick', handleDoubleActivate);
      }

      // Mouse drag: pan when zoomed, swipe to navigate when not
      let lbMouseDown = false, lbMouseStartX = 0, lbMouseStartY = 0, lbPanOriginX = 0, lbPanOriginY = 0;

      if (lightboxViewport) {
        lightboxViewport.addEventListener('mousedown', function(e) {
          lbMouseDown = true;
          lbMouseStartX = e.clientX;
          lbMouseStartY = e.clientY;
          if (zoomScale > 1) {
            lbPanOriginX = panX;
            lbPanOriginY = panY;
            lightboxImage.classList.add('panning');
          }
        });

        document.addEventListener('mousemove', function(e) {
          if (!lbMouseDown || zoomScale <= 1) return;
          panX = lbPanOriginX + (e.clientX - lbMouseStartX);
          panY = lbPanOriginY + (e.clientY - lbMouseStartY);
          clampPan();
          applyTransform(false);
        });

        document.addEventListener('mouseup', function(e) {
          if (!lbMouseDown) return;
          lbMouseDown = false;
          lightboxImage.classList.remove('panning');
          if (zoomScale === 1) {
            const diffX = lbMouseStartX - e.clientX;
            if (Math.abs(diffX) > 50) {
              if (diffX > 0) { nextSlide(); updateLightboxImage(); }
              else { prevSlide(); updateLightboxImage(); }
            }
          }
        });
      }

      // Touch: single-finger pan/swipe, two-finger pinch-zoom, double-tap to toggle zoom
      let lbTouchActive = false, lbTouchStartX = 0, lbTouchStartY = 0;
      let lbPinchStartDist = 0, lbPinchStartScale = 1, lbLastTapTime = 0;

      function touchDistance(touches) {
        const dx = touches[0].clientX - touches[1].clientX;
        const dy = touches[0].clientY - touches[1].clientY;
        return Math.sqrt(dx * dx + dy * dy);
      }

      if (lightboxViewport) {
        lightboxViewport.addEventListener('touchstart', function(e) {
          if (e.touches.length === 2) {
            lbTouchActive = false;
            lbPinchStartDist = touchDistance(e.touches);
            lbPinchStartScale = zoomScale;
          } else if (e.touches.length === 1) {
            lbTouchActive = true;
            lbTouchStartX = e.touches[0].clientX;
            lbTouchStartY = e.touches[0].clientY;
            lbPanOriginX = panX;
            lbPanOriginY = panY;

            const now = Date.now();
            if (now - lbLastTapTime < 300) {
              handleDoubleActivate();
              lbTouchActive = false;
            }
            lbLastTapTime = now;
          }
        }, { passive: true });

        lightboxViewport.addEventListener('touchmove', function(e) {
          if (e.touches.length === 2) {
            e.preventDefault();
            const dist = touchDistance(e.touches);
            const factor = dist / (lbPinchStartDist || dist);
            setZoom(lbPinchStartScale * factor, false);
          } else if (e.touches.length === 1 && lbTouchActive && zoomScale > 1) {
            e.preventDefault();
            panX = lbPanOriginX + (e.touches[0].clientX - lbTouchStartX);
            panY = lbPanOriginY + (e.touches[0].clientY - lbTouchStartY);
            clampPan();
            applyTransform(false);
          }
        }, { passive: false });

        lightboxViewport.addEventListener('touchend', function(e) {
          if (lbTouchActive && zoomScale === 1 && e.changedTouches && e.changedTouches.length) {
            const diffX = lbTouchStartX - e.changedTouches[0].clientX;
            if (Math.abs(diffX) > 50) {
              if (diffX > 0) { nextSlide(); updateLightboxImage(); }
              else { prevSlide(); updateLightboxImage(); }
            }
          }
          lbTouchActive = false;
        });
      }

      // ---------- Main image: swipe (mouse or touch) to change slide, tap to open the zoom viewer ----------
      let mDown = false, mStartX = 0, mStartY = 0, mMoved = false;

      if (imageSlider) {
        imageSlider.addEventListener('mousedown', function(e) {
          if (e.target.closest('#prevSlide, #nextSlide, .zoom-badge')) return;
          mDown = true;
          mMoved = false;
          mStartX = e.clientX;
          mStartY = e.clientY;
        });

        document.addEventListener('mousemove', function(e) {
          if (!mDown) return;
          if (Math.abs(e.clientX - mStartX) > 10 || Math.abs(e.clientY - mStartY) > 10) mMoved = true;
        });

        document.addEventListener('mouseup', function(e) {
          if (!mDown) return;
          mDown = false;
          const diffX = mStartX - e.clientX;
          if (Math.abs(diffX) > 50) {
            if (diffX > 0) nextSlide(); else prevSlide();
          } else if (!mMoved) {
            openLightbox();
          }
        });

        let tStartX = 0, tStartY = 0, tMoved = false;

        imageSlider.addEventListener('touchstart', function(e) {
          if (e.target.closest('#prevSlide, #nextSlide, .zoom-badge')) return;
          tMoved = false;
          tStartX = e.touches[0].clientX;
          tStartY = e.touches[0].clientY;
        }, { passive: true });

        imageSlider.addEventListener('touchmove', function(e) {
          if (Math.abs(e.touches[0].clientX - tStartX) > 10 || Math.abs(e.touches[0].clientY - tStartY) > 10) tMoved = true;
        }, { passive: true });

        imageSlider.addEventListener('touchend', function(e) {
          const endTouch = (e.changedTouches && e.changedTouches[0]) ? e.changedTouches[0].clientX : tStartX;
          const diffX = tStartX - endTouch;
          if (Math.abs(diffX) > 50) {
            if (diffX > 0) nextSlide(); else prevSlide();
          } else if (!tMoved) {
            openLightbox();
          }
        });
      }

      // ---------- Review photo lightbox (standalone, separate from the product gallery one) ----------
      (function() {
        const backdrop = document.getElementById('reviewLightbox');
        if (!backdrop) return; // no reviews on this page - nothing to wire up

        const imgEl = document.getElementById('reviewLightboxImg');
        const closeBtn = document.getElementById('reviewLightboxClose');
        const prevBtn = document.getElementById('reviewLightboxPrev');
        const nextBtn = document.getElementById('reviewLightboxNext');

        let currentImages = [];
        let currentIndex = 0;

        function show(index) {
          if (!currentImages.length) return;
          currentIndex = (index + currentImages.length) % currentImages.length;
          imgEl.src = currentImages[currentIndex];
          const multi = currentImages.length > 1;
          prevBtn.style.display = multi ? 'flex' : 'none';
          nextBtn.style.display = multi ? 'flex' : 'none';
        }

        function openLightbox(images, startIndex) {
          currentImages = images;
          show(startIndex);
          backdrop.classList.add('active');
          document.body.style.overflow = 'hidden';
        }

        function closeLightbox() {
          backdrop.classList.remove('active');
          document.body.style.overflow = '';
        }

        document.querySelectorAll('.review-thumb').forEach(function(thumb) {
          thumb.addEventListener('click', function() {
            const wrap = thumb.closest('[data-review-images]');
            if (!wrap) return;
            let images = [];
            try { images = JSON.parse(wrap.getAttribute('data-review-images')); } catch (e) { return; }
            const idx = parseInt(thumb.getAttribute('data-index')) || 0;
            openLightbox(images, idx);
          });
        });

        closeBtn.addEventListener('click', closeLightbox);
        backdrop.addEventListener('click', function(e) { if (e.target === backdrop) closeLightbox(); });
        prevBtn.addEventListener('click', function() { show(currentIndex - 1); });
        nextBtn.addEventListener('click', function() { show(currentIndex + 1); });

        document.addEventListener('keydown', function(e) {
          if (!backdrop.classList.contains('active')) return;
          if (e.key === 'Escape') closeLightbox();
          else if (e.key === 'ArrowLeft') show(currentIndex - 1);
          else if (e.key === 'ArrowRight') show(currentIndex + 1);
        });
      })();

    // ---------- Tabs ----------
function initializeTabs() {
    const tabButtons = document.querySelectorAll('.tab-btn');
    
    tabButtons.forEach(btn => {
        // Remove any existing listeners to prevent duplicates
        btn.replaceWith(btn.cloneNode(true));
    });
    
    // Get fresh references
    const freshTabButtons = document.querySelectorAll('.tab-btn');
    
    freshTabButtons.forEach(btn => {
        btn.addEventListener('click', function(){
            const target = this.dataset.tab;
            if (!target) return;
            
            // Update button states
            freshTabButtons.forEach(b => {
                b.classList.remove('text-gray-900', 'active', 'border-[color:var(--accent)]');
                b.classList.add('text-gray-600', 'border-transparent');
            });
            
            // Hide all panels
            document.querySelectorAll('.tab-panel').forEach(p => {
                p.classList.add('hidden');
            });
            
            // Activate clicked button
            this.classList.add('text-gray-900', 'active', 'border-[color:var(--accent)]');
            this.classList.remove('text-gray-600', 'border-transparent');
            
            // Show target panel
            const panel = document.getElementById(target);
            if (panel) {
                panel.classList.remove('hidden');
                
                // Special handling for mobile video
                if (target === 'video' && window.innerWidth < 768) {
                    const iframe = panel.querySelector('iframe');
                    if (iframe) {
                        iframe.style.minHeight = '250px';
                    }
                }
            }

            // trigger a resize if model viewer becomes visible
            if (target === 'model3d') {
                setTimeout(() => window.dispatchEvent(new Event('resize')), 120);
            }
        });
    });
    
    // Debug: Log available tabs
    console.log('Available tabs:', Array.from(freshTabButtons).map(btn => btn.dataset.tab));
}

// Initialize tabs when DOM is ready
document.addEventListener('DOMContentLoaded', initializeTabs);

// Re-initialize tabs if content is loaded dynamically
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeTabs);
} else {
    initializeTabs();
}
// ---------- Enhanced AddToCart tracking (PRODUCT HOME VERSION) ----------
const addForm = document.getElementById('addToCartForm');

if (addForm) {
  addForm.addEventListener('submit', function(e){
    e.preventDefault();

    // MAIN PRODUCT QUANTITY (CLIENT CHOICE) - clamped client-side for UX;
    // the server re-clamps too, this is not the security boundary on its own.
    const MAX_QTY = 50;
    const qtyInput = document.getElementById('qtyInput');
    const mainQty = qtyInput ? Math.min(MAX_QTY, Math.max(1, parseInt(qtyInput.value) || 1)) : 1;
    const mainProductId = '<%= producthome._id %>';
    const mainPrice = <%= producthome.price %>;

    // SECOND PRODUCT (FIXED QTY = 1)
    const selectedSecond = document.querySelector("input[name='secondProduct']:checked");
    const secondProductId = selectedSecond ? selectedSecond.value : null;
    const secondPrice = selectedSecond ? parseFloat(selectedSecond.dataset.price) : 0;
    const discountedSecondPrice = secondPrice * 0.9;

    // META CONTENTS
    const contents = [{
      id: mainProductId,
      quantity: mainQty,
      item_price: mainPrice
    }];

    let totalValue = mainPrice * mainQty;

    if (secondProductId) {
      contents.push({
        id: secondProductId,
        quantity: 1,
        item_price: discountedSecondPrice
      });
      totalValue += discountedSecondPrice;
    }

    try {
      if (window.fbq) {
        const serverEventId = '<%= metaEventIdCart %>';
        const activeSwatch = document.querySelector('.finish-swatch.active');
        const selectedFinish = activeSwatch ? activeSwatch.getAttribute('data-finish') : 'Ceramic Matte';

        window.fbq('track', 'AddToCart', {
          content_name: <%- JSON.stringify(producthome.title) %>,
          content_ids: secondProductId
            ? [mainProductId, secondProductId]
            : [mainProductId],
          content_type: 'product',
          value: totalValue,
          currency: 'DZD',
          contents: contents,
          finish: selectedFinish
        }, {
          eventID: serverEventId
        });

        console.log('🎯 AddToCart Event ID:', serverEventId, 'Finish:', selectedFinish);
      }
    } catch (err) {
      console.warn('fbq AddToCart failed', err);
    }

    // Push GA4 add_to_cart event to window.dataLayer (matching GTM tag parameters)
    try {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'add_to_cart',
        currency: 'DZD',
        value: totalValue,
        productPrice: mainPrice,
        price: mainPrice,
        productId: mainProductId,
        item_id: mainProductId,
        productName: <%- JSON.stringify(producthome.title) %>,
        item_name: <%- JSON.stringify(producthome.title) %>,
        quantity: mainQty
      });
    } catch(e) {
      console.warn('dataLayer add_to_cart push failed', e);
    }

    // REDIRECT (SEND MAIN QTY + SECOND PRODUCT)
    let redirectUrl = `/add-to-cart-producthome/${mainProductId}?qty=${mainQty}`;

    if (secondProductId) {
      redirectUrl += `&second=${secondProductId}`;
    }

    setTimeout(() => {
      window.location.href = redirectUrl;
    }, 150);
  });
}

