    font-family: "Helvetica Neue", Arial, sans-serif;
    font-weight: 300;
    letter-spacing: 0.5px;
    color: #000;
}

section.my-32 .text-sm {
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-size: 14px;
    color: #666;
    line-height: 1.6;
}

/* 13. RESPONSIVE ADJUSTMENTS */
@media (max-width: 768px) {
    /* Mobile adjustments */
    .thumbnail {
        width: 60px;
        height: 60px;
    }
    
    .thumbnail img {
        width: 58px;
        height: 58px;
    }
    
    .offer-slider {
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
    }
    
    .image-container img {
        height: 220px;
    }
    
    .snap-child {
        width: 200px;
    }
    
    .snap-child img {
        height: 260px;
    }
    
    /* Hide arrows on mobile */
    #prevSlide, #nextSlide,
    #prevRelated, #nextRelated {
        display: none;
    }
}

@media (max-width: 480px) {
    .offer-slider {
        grid-template-columns: 1fr;
    }
    
    .image-container img {
        height: 280px;
    }
}

/* 14. SHARE SECTION - ZARA STYLE */
.mt-8.flex.gap-3.items-center {
    border-top: 1px solid #e5e5e5;
    padding-top: 20px;
    margin-top: 32px;
}

.mt-8.flex.gap-3.items-center .font-medium {
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #000;
}

.mt-8.flex.gap-3.items-center a {
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-size: 12px;
    color: #666;
    text-decoration: none;
    transition: color 0.3s ease;
}

.mt-8.flex.gap-3.items-center a:hover {
    color: #000;
    text-decoration: underline;
}

/* 15. FOOTER - ZARA STYLE */
footer {
    border-top: 1px solid #e5e5e5;
    background: #fff;
}

footer .text-sm {
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-size: 11px;
    color: #666;
    text-align: center;
    letter-spacing: 0.5px;
}

/* 16. ZARA-STYLE PRODUCT TITLE IN MAIN CONTENT */
h1.text-2xl.font-semibold.text-gray-900 {
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-weight: 400;
    font-size: 20px;
    letter-spacing: 0.8px;
    line-height: 1.3;
    text-transform: uppercase;
    color: #000;
    margin-bottom: 12px;
}

/* 17. REMOVE ROUNDED CORNERS FOR ZARA MINIMAL LOOK */
.bg-white.rounded-2xl {
    border-radius: 0;
    border: 1px solid #f0f0f0;
}

.rounded-xl, .rounded-lg, .rounded-full {
    border-radius: 0;
}

/* 18. ZARA-STYLE LIGHTBOX */
.lightbox-backdrop {
    background: rgba(255, 255, 255, 0.98);
}

.lightbox-nav {
    background: #000;
    border: 1px solid #000;
    width: 50px;
    height: 50px;
    border-radius: 0;
    color: #fff;
}

.lightbox-nav:hover {
    background: #fff;
    color: #000;
}

.lightbox-close {
    background: #000;
    border: 1px solid #000;
    width: 40px;
    height: 40px;
    border-radius: 0;
    color: #fff;
}

.lightbox-close:hover {
    background: #fff;
    color: #000;
}

/* 19. ZARA-STYLE COLOR ACCENT */
:root {
    --accent: #000; /* Changed to black for Zara style */
}

/* Update any existing accent color usage */
[style*="color:var(--accent)"] {
    color: #000 !important;
}

[style*="background:var(--accent)"] {
    background: #000 !important;
}

/* 20. ENHANCED TRANSITIONS */
.thumbnail, .gallery-item, .snap-child, .offer-card,
#addToCartBtn, #buyNowBtn, .learn-more-link {
    transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
}

/* 21. ZARA-STYLE LOADING STATE */
#addToCartBtn:disabled,
#buyNowBtn:disabled {
    background: #666;
    border-color: #666;
    color: #999;
    cursor: not-allowed;
}

/* 22. PRODUCT TABS CONTENT SPACING */
.tab-panel#desc,
.tab-panel#shipping,
.tab-panel#guarantee,
.tab-panel#info {
    padding: 32px 0;
}

/* Add subtle border between tab content sections */
.tab-panel > * + * {
    margin-top: 24px;
}

/* 23. ZARA-STYLE FORM ELEMENTS */
input, select, textarea {
    font-family: "Helvetica Neue", Arial, sans-serif;
    border: 1px solid #e5e5e5;
    border-radius: 0;
    padding: 10px 12px;
    font-size: 14px;
}

input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: #000;
}

