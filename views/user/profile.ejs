<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mon Profil | Paintello</title>
    
    <meta name="facebook-domain-verification" content="plfly5a8dktgdy17nvv2h8zsrpc9g5" />
    
    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png">
    <link rel="manifest" href="/favicon/site.webmanifest">  
    <meta name="theme-color" content="#ffffff">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
/* Add these styles to match track-order page */
.progress-container {
    background: #f8f9fa;
    border-radius: 10px;
    height: 6px;
    margin: 10px 0;
}

.progress-bar {
    height: 100%;
    border-radius: 10px;
    background: #000;
    transition: width 0.3s ease;
}

/* Status Colors */
.status-pending { background: #fff3cd; color: #856404; }
.status-confirmed { background: #cce7ff; color: #004085; }
.status-processing { background: #d1ecf1; color: #0c5460; }
.status-ready_for_pickup { background: #d1f7c4; color: #155724; }
.status-shipped { background: #e2e3ff; color: #383d41; }
.status-out_for_delivery { background: #fff3cd; color: #856404; }
.status-delivered { background: #d4edda; color: #155724; }
.status-cancelled { background: #f8d7da; color: #721c24; }
.status-refunded { background: #e2e3e5; color: #383d41; }
.status-on_hold { background: #fff3cd; color: #856404; }

.status-badge {
    font-size: 11px;
    letter-spacing: 0.5px;
    padding: 4px 8px;
    border-radius: 1px;
    text-transform: uppercase;
}

.stat-card {
    background: #f8f8f8;
    padding: 20px;
    border-radius: 2px;
    text-align: center;
}

.stat-number {
    font-size: 24px;
    font-weight: 300;
    color: #000;
    margin-bottom: 4px;
}

.stat-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #666;
}

.order-card { border-bottom: 1px solid #e5e5e5; padding: 16px 0; }
.order-card:last-child { border-bottom: none; }
    </style>
<!-- Meta Pixel Code -->
    <% if (process.env.FB_PIXEL_ID) { %>
    <script>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');

    var pixelConfig = {};
    <% if (user && user.email) { %> pixelConfig.em = <%- JSON.stringify(user.email) %>; <% } %>
    <% if (user && user.firstName) { %> pixelConfig.fn = <%- JSON.stringify(user.firstName) %>; <% } %>
    <% if (user && user.lastName) { %> pixelConfig.ln = <%- JSON.stringify(user.lastName) %>; <% } %>
    <% if (user && user.numero) { %> pixelConfig.ph = <%- JSON.stringify(user.numero) %>; <% } %>
    <% if (user && user._id) { %> pixelConfig.external_id = <%- JSON.stringify(String(user._id)) %>; <% } %>

    fbq('init', '<%= process.env.FB_PIXEL_ID %>', pixelConfig);
    fbq('track', 'PageView', {}, { eventID: '<%= metaEventIdPageView %>' });
    </script>
    <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=<%= process.env.FB_PIXEL_ID %>&ev=PageView&noscript=1"/></noscript>
    <% } %>

    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-K8PWQM45');</script>
<script type="text/javascript">
    (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "t8r0mi7k1l");
  </script>

</head>

<body class="min-h-screen bg-white">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-K8PWQM45" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

    <!-- Minimal Header -->
    <header class="border-b border-gray-200 bg-white">
        <div class="max-w-7xl mx-auto px-6 py-4">
            <div class="flex items-center justify-between">
                <!-- Logo -->
                <a href="/" class="flex items-center gap-4">
                    <img src="/favicon/android-chrome-192x192.png" alt="Paintello" class="h-8 w-8">
                    <img src="/img/logo.png" alt="Paintello Home" class="h-10 w-auto">
                </a>

                <!-- Navigation -->
                <nav class="hidden md:flex items-center gap-8">
                    <a href="/" class="header-link">Accueil</a>
                    <a href="/shop" class="header-link">Boutique</a>
                    <a href="/track-login" class="header-link">Suivi Commande</a>
                </nav>

                <!-- Icons -->
                <div class="flex items-center gap-4">
                    <a href="/shop" class="relative text-gray-600 hover:text-gray-900">
                        <i class="fa-solid fa-bag-shopping text-lg"></i>
                        <% if (req.session.cart && req.session.cart.totalQty > 0) { %>
                            <span class="absolute -top-2 -right-2 bg-black text-white text-xs px-1.5 py-0.5 rounded-full"><%= req.session.cart.totalQty %></span>
                        <% } %>
                    </a>
                    
                    <div class="relative group">
                        <a href="#" class="text-gray-600 hover:text-gray-900">
                            <i class="fa-regular fa-user text-lg"></i>
                        </a>
                        <div class="absolute right-0 top-full mt-2 w-48 bg-white border border-gray-200 shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-10">
                            <a href="/user/signup" class="block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 border-b border-gray-100">S'inscrire</a>
                            <a href="/user/signin" class="block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50">Se connecter</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main class="py-16">
        <div class="max-w-4xl mx-auto px-6">
            
            <!-- Profile Header -->
            <!-- In profile.ejs, update the member since section -->
<div class="flex flex-col md:flex-row items-start md:items-center justify-between mb-10">
    <div>
        <h1 class="text-2xl font-light tracking-wide uppercase mb-2">Bonjour, <%= user.firstName %></h1>
        <p class="text-sm text-gray-600">
            <!-- SAFE: Handle all cases -->
            <% 
                let memberSinceDate;
                if (userStats && userStats.memberSince) {
                    memberSinceDate = new Date(userStats.memberSince);
                } else if (user && user.createdAt) {
                    memberSinceDate = new Date(user.createdAt);
                } else if (user && user._id) {
                    // Extract from ObjectId
                    memberSinceDate = user._id.getTimestamp ? user._id.getTimestamp() : new Date();
                } else {
                    memberSinceDate = new Date();
                }
            %>
            Membre depuis <%= memberSinceDate.toLocaleDateString('fr-FR', { 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric' 
            }) %>
        </p>
        <% if (registrationEventId && process.env.NODE_ENV !== 'production') { %>
        <p class="text-xs text-gray-400 mt-1">ID Inscription: <%= registrationEventId %></p>
        <% } %>
    </div>
    <div class="flex flex-wrap items-center gap-3 mt-4 md:mt-0">
        <% if (user && user.isAdmin) { %>
        <a href="/user/admin/orders" class="px-4 py-2 text-xs font-semibold uppercase tracking-wider text-white bg-black hover:opacity-80 transition shadow">
            <i class="fa-solid fa-boxes-packing mr-2"></i>Commandes Admin
        </a>
        <a href="/user/admin/finance" class="px-4 py-2 text-xs font-semibold uppercase tracking-wider text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 transition">
            <i class="fa-solid fa-chart-line mr-2"></i>Finance & Profit
        </a>
        <a href="/user/admin/products/new" class="px-4 py-2 text-xs font-semibold uppercase tracking-wider text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 transition">
            <i class="fa-solid fa-plus mr-2"></i>New Product
        </a>
        <a href="/user/admin/whatsapp" class="px-4 py-2 text-xs font-semibold uppercase tracking-wider text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 transition">
            <i class="fa-brands fa-whatsapp mr-2"></i>WhatsApp
        </a>
        <a href="/user/admin/reviews" class="px-4 py-2 text-xs font-semibold uppercase tracking-wider text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 transition">
            <i class="fa-solid fa-star mr-2"></i>Reviews
        </a>
        <% } %>
        <a href="/user/logout" class="px-4 py-2 text-xs font-semibold uppercase tracking-wider text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 transition">
            <i class="fas fa-sign-out-alt mr-2"></i>Déconnexion
        </a>
    </div>
</div>

            <!-- User Stats -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
                <div class="stat-card">
                    <div class="stat-number"><%= userStats.totalOrders %></div>
                    <div class="stat-label">Commandes</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number"><%= userStats.totalSpent %> DZD</div>
                    <div class="stat-label">Total dépensé</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number"><%= userStats.totalItems %></div>
                    <div class="stat-label">Articles achetés</div>
                </div>
            </div>

          <!-- Orders Section -->
<div class="zara-card p-8 mb-8">
    <h2 class="text-sm font-medium uppercase tracking-wide mb-6 border-b border-gray-200 pb-3">
        Mes Commandes (<%= userStats.totalOrders %>)
    </h2>
    
    <% if (orders.length === 0) { %>
        <div class="text-center py-12">
            <i class="fas fa-shopping-bag text-gray-300 text-4xl mb-4"></i>
            <p class="text-sm text-gray-600 mb-4">Vous n'avez pas encore passé de commande</p>
            <a href="/shop" class="zara-btn inline-block">
                <i class="fas fa-shopping-bag mr-2"></i>Découvrir la boutique
            </a>
        </div>
    <% } else { %>
        <!-- Statistics Cards -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
            <div class="stat-card">
                <div class="stat-number"><%= userStats.totalOrders %></div>
                <div class="stat-label">Total Commandes</div>
            </div>
            <div class="stat-card">
                <div class="stat-number"><%= userStats.totalSpent %> DZD</div>
                <div class="stat-label">Total Dépensé</div>
            </div>
            <div class="stat-card">
                <div class="stat-number"><%= userStats.deliveredOrders %></div>
                <div class="stat-label">Commandes Livrées</div>
            </div>
            <div class="stat-card">
                <div class="stat-number"><%= userStats.deliveredItems %></div>
                <div class="stat-label">Articles Livrés</div>
            </div>
        </div>
        
        <!-- Order Status Breakdown -->
        <div class="mb-8">
            <h3 class="text-xs text-gray-500 uppercase tracking-wide mb-4">Statut des Commandes</h3>
            <div class="grid grid-cols-2 md:grid-cols-6 gap-2">
                <div class="text-center p-3 <%= userStats.statusCounts.pending > 0 ? 'bg-yellow-50 border border-yellow-200' : 'bg-gray-50' %>">
                    <div class="text-lg font-semibold <%= userStats.statusCounts.pending > 0 ? 'text-yellow-700' : 'text-gray-400' %>"><%= userStats.statusCounts.pending %></div>
                    <div class="text-xs <%= userStats.statusCounts.pending > 0 ? 'text-yellow-600' : 'text-gray-500' %>">En Attente</div>
                </div>
                <div class="text-center p-3 <%= userStats.statusCounts.confirmed > 0 ? 'bg-blue-50 border border-blue-200' : 'bg-gray-50' %>">
                    <div class="text-lg font-semibold <%= userStats.statusCounts.confirmed > 0 ? 'text-blue-700' : 'text-gray-400' %>"><%= userStats.statusCounts.confirmed %></div>
                    <div class="text-xs <%= userStats.statusCounts.confirmed > 0 ? 'text-blue-600' : 'text-gray-500' %>">Confirmées</div>
                </div>
                <div class="text-center p-3 <%= userStats.statusCounts.processing > 0 ? 'bg-indigo-50 border border-indigo-200' : 'bg-gray-50' %>">
                    <div class="text-lg font-semibold <%= userStats.statusCounts.processing > 0 ? 'text-indigo-700' : 'text-gray-400' %>"><%= userStats.statusCounts.processing %></div>
                    <div class="text-xs <%= userStats.statusCounts.processing > 0 ? 'text-indigo-600' : 'text-gray-500' %>">En Préparation</div>
                </div>
                <div class="text-center p-3 <%= userStats.statusCounts.shipped > 0 ? 'bg-purple-50 border border-purple-200' : 'bg-gray-50' %>">
                    <div class="text-lg font-semibold <%= userStats.statusCounts.shipped > 0 ? 'text-purple-700' : 'text-gray-400' %>"><%= userStats.statusCounts.shipped %></div>
                    <div class="text-xs <%= userStats.statusCounts.shipped > 0 ? 'text-purple-600' : 'text-gray-500' %>">Expédiées</div>
                </div>
                <div class="text-center p-3 <%= userStats.statusCounts.delivered > 0 ? 'bg-green-50 border border-green-200' : 'bg-gray-50' %>">
                    <div class="text-lg font-semibold <%= userStats.statusCounts.delivered > 0 ? 'text-green-700' : 'text-gray-400' %>"><%= userStats.statusCounts.delivered %></div>
                    <div class="text-xs <%= userStats.statusCounts.delivered > 0 ? 'text-green-600' : 'text-gray-500' %>">Livrées</div>
                </div>
                <div class="text-center p-3 <%= userStats.statusCounts.cancelled > 0 ? 'bg-red-50 border border-red-200' : 'bg-gray-50' %>">
                    <div class="text-lg font-semibold <%= userStats.statusCounts.cancelled > 0 ? 'text-red-700' : 'text-gray-400' %>"><%= userStats.statusCounts.cancelled %></div>
                    <div class="text-xs <%= userStats.statusCounts.cancelled > 0 ? 'text-red-600' : 'text-gray-500' %>">Annulées</div>
                </div>
            </div>
        </div>
        
        <!-- Orders List -->
        <div class="space-y-6">
            <% orders.forEach(order => { %>
            <div class="zara-card p-6">
                <!-- Order Header -->
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4 pb-4 border-b border-gray-200">
                    <div class="flex items-center gap-3 mb-3 sm:mb-0">
                        <span class="status-badge">
                            Commande #<%= order._id.toString().slice(-6).toUpperCase() %>
                        </span>
                        <span class="status-badge status-<%= order.status %>">
                            <%= getStatusText(order.status) %>
                        </span>
                        <% if (order.orderSource) { %>
                        <span class="text-xs <%= order.orderSource.type === 'guest' ? 'bg-gray-100 text-gray-600' : 'bg-green-100 text-green-600' %> px-2 py-1 rounded">
                            <i class="<%= order.orderSource.icon %> mr-1"></i><%= order.orderSource.label %>
                        </span>
                        <% } %>
                    </div>
                    <div class="text-xs text-gray-500">
                        <%= order.createdAt.toLocaleDateString('fr-FR') %>
                    </div>
                </div>

                <!-- Order Progress -->
                <div class="mb-4">
                    <div class="flex justify-between text-xs text-gray-500 mb-1">
                        <span>Commandé</span>
                        <span>Confirmé</span>
                        <span>Expédié</span>
                        <span>Livré</span>
                    </div>
                    <div class="progress-container">
                        <div class="progress-bar" style="width: <%= getProgressWidth(order.status) %>%;"></div>
                    </div>
                </div>

                <!-- Order Details -->
                <div class="grid md:grid-cols-2 gap-6 mb-4">
                    <div class="space-y-3">
                        <div>
                            <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Articles</p>
                            <div class="space-y-2">
                                <% order.items.forEach(item => {
                                     const product = item.item || {};
                                     const title = product.title || 'Article indisponible';
                                     const price = product.price || 0;
                                %>
                                <div class="flex items-center justify-between text-sm">
                                    <span><%= title %></span>
                                    <span class="text-gray-600"><%= item.qty %> x <%= price %> DZD</span>
                                </div>
                                <% }) %>
                            </div>
                        </div>
                        <div>
                            <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Total Articles</p>
                            <p class="text-sm font-medium"><%= order.cart.totalPrice %> DZD</p>
                        </div>
                    </div>
                    
                    <div class="space-y-3">
                        <div>
                            <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Livraison</p>
                            <p class="text-sm">Frais: <%= order.shippingFee || 0 %> DZD</p>
                            <p class="text-sm">Délai: <%= order.deliveryDelay || 'Non spécifié' %></p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Total</p>
                            <p class="text-lg font-semibold"><%= order.totalWithShipping || order.cart.totalPrice %> DZD</p>
                        </div>
                        <% if (order.trackingNumber) { %>
                        <div>
                            <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Numéro de Suivi</p>
                            <p class="text-sm font-mono"><%= order.trackingNumber %></p>
                        </div>
                        <% } %>
                    </div>
                </div>

                <!-- Actions -->
                <div class="border-t border-gray-200 pt-4 flex flex-col sm:flex-row gap-3">
                    <a href="/contact?order=<%= order._id %>" 
                       class="zara-btn-secondary text-sm text-center flex-1">
                        Support Client
                    </a>
                    <% if (order.status === 'delivered' && order.canReturn) { %>
                    <a href="/start-return/<%= order._id %>" 
                       class="zara-btn text-sm text-center flex-1">
                        Demander un Retour
                    </a>
                    <% } %>
                </div>
            </div>
            <% }) %>
        </div>
    <% } %>
</div>

            <!-- User Info -->
            <div class="zara-card p-8">
                <h2 class="text-sm font-medium uppercase tracking-wide mb-6 border-b border-gray-200 pb-3">
                    Mes Informations
                </h2>
                
                <div class="grid md:grid-cols-2 gap-6">
                    <div class="space-y-4">
                        <div>
                            <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Nom complet</p>
                            <p class="text-sm"><%= user.firstName %> <%= user.lastName %></p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Email</p>
                            <p class="text-sm"><%= user.email %></p>
                        </div>
                    </div>
                    
                    <div class="space-y-4">
                        <div>
                            <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Téléphone</p>
                            <p class="text-sm"><%= user.numero %></p>
                        </div>
                        <div>
                            <a href="/user/edit-profile" class="text-sm text-gray-600 hover:text-black inline-block">
                                <i class="fas fa-edit mr-2"></i>Modifier mes informations
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

 <!-- Minimal Footer -->
    <footer class="border-t border-gray-200 py-8 mt-12">
        <div class="max-w-7xl mx-auto px-6 text-center">
            <p class="text-sm text-gray-600">© <%= new Date().getFullYear() %> Paintello</p>
        </div>
    </footer>
</body>
</html>
